<?ish ishref="GUID-CF5E8203-1AAC-4BAD-80AA-7EC3CE89B42F" version="1" lang="en-US"?><task id="GUID-CF5E8203-1AAC-4BAD-80AA-7EC3CE89B42F" xml:lang="en-US"> 
  <title id="GUID-57D29A22-8935-46A4-AF80-60F9AF2F7D5F">Copy a Single Page</title> 
  <shortdesc>Use the document glass to copy a single page document. 
  </shortdesc> 
  <prolog> 
	 <metadata> 
		<keywords> 
		  <keyword ishcondition="MODEL=810AIO">810AIO</keyword> 
		  <keyword ishcondition="MODEL=820AIO">820AIO</keyword> 
		  <keyword ishcondition="MODEL=910AIO">910AIO</keyword> 
		  <keyword ishcondition="MODEL=920AIO">920AIO</keyword> 
		  <keyword ishcondition="Series='800_Series'"> 800 Series</keyword> 
		  <keyword ishcondition="Series='900_Series'"> 900 Series</keyword> 
		  <keyword>Acadian</keyword> 
		  <indexterm>copying<indexterm>single page</indexterm></indexterm> 
		  <indexterm>documents<indexterm>copying single page</indexterm></indexterm> 
		</keywords> </metadata>
  </prolog> 
  <taskbody> 
	 <steps id="STEPS_5AD41D7A09F547B3AED2BF8BCF86C5FC"> 
		<step id="TURN_PRINTER_ON"> 
		  <cmd>Turn the printer on. 
		  </cmd> 
		</step> 
		<step id="PRESS_COPY_BUTTON"> 
		  <cmd>Press the 
			 <uicontrol>Copy</uicontrol> button. 
		  </cmd> 
		</step> 
		<step id="OPEN_DOC_COVER"> 
		  <cmd>Open the document cover. 
		  </cmd> 
		</step> 
		<step id="PLACE_DOC_GLASS"> 
		  <cmd>Place the original document print side down on the glass. 
		  </cmd> 
		  <info> 
			 <note id="GUID-014D904A-1E5A-4150-A231-4F1099726063" conref="GUID-9244599E-6CDD-4C73-A045-1D2BFB0399A2#GUID-9244599E-6CDD-4C73-A045-1D2BFB0399A2/CAUTION_NO_HEAVY_OBJECTS">Do not place heavy objects on the glass. 
			 </note> 
		  </info> 
		</step> 
		<step id="ALIGN_DOC_GLASS"> 
		  <cmd>Align the document with the guides on the glass. 
		  </cmd> 
		</step> 
		<step id="CLOSE_DOC_COVER"> 
		  <cmd>Carefully close the document cover. 
		  </cmd> 
		  <info /> 
		</step> 
		<step id="SET_NUMBER_COPIES"> 
		  <cmd>Use the number buttons to specify the number of copies to make. 
		  </cmd> 
		  <info>The default is one copy. 
		  </info> 
		</step> 
		<step id="SET_BW_OR_COLOR"> 
		  <cmd>Specify to make black-and-white or color copies. 
		  </cmd> 
		</step> 
		<step id="PRESS_GO_BUTTON"> 
		  <cmd>Press the 
			 <uicontrol>GO</uicontrol> button. 
		  </cmd> 
		  <stepresult>The printer delivers the copies through the Document Output Feeder. 
		  </stepresult> 
		</step> 
	 </steps> 
  </taskbody> 
</task>
