<!DOCTYPE task PUBLIC "-//SDL//DTD DITA Task//EN" "sdlTask.dtd"[]>
<?ish ishref="GUID-48FF09FC-D1C4-4B91-B116-1FB32FEFCA4F" version="1" lang="en-US"?><task id="GUID-48FF09FC-D1C4-4B91-B116-1FB32FEFCA4F" xml:lang="en-US"> 
  <title id="GUID-53F6B3E3-392A-4CE6-ADC7-5B9BE215353F">Copy Both Sides of a Document</title> 
  <shortdesc>Use the Automatic Document Feeder (ADF) to copy both sides of an original document. 
  </shortdesc> 
  <prolog> 
	 <metadata> 
		<keywords> 
		  <keyword ishcondition="MODEL=810AIO">810AIO</keyword> 
		  <keyword ishcondition="MODEL=820AIO">820AIO</keyword> 
		  <keyword ishcondition="MODEL=910AIO">910AIO</keyword> 
		  <keyword ishcondition="MODEL=920AIO">920AIO</keyword> 
		  <keyword ishcondition="Series='800_Series'"> 800 Series</keyword> 
		  <keyword ishcondition="Series='900_Series'"> 900 Series</keyword> 
		  <keyword>Acadian</keyword> 
		  <indexterm>copying<indexterm>double-sided documents</indexterm></indexterm> 
		  <indexterm>documents<indexterm>copying both sides</indexterm></indexterm> 
		</keywords> </metadata>
  </prolog> 
  <taskbody> 
	 <context id="CONTEXT_CCA35AE92F244959A6716C8D3F267D5F"> 
		<p> You can copy double-sided documents and generate copies the following: 
		<ul id="UL_EC3D4C8C8A1F4083A03C130803569470"> 
		  <li id="LI_C58D806B2C404893B1B51D4CEC39C31C">Two sides to two sides (1 double-sided page to 1 double-sided page) 
		  </li> 
		  <li id="LI_83B748CCA6DF494889CFE07254705C6C">Two sides to one side (1 double-sided page to 2 single-sided pages) 
		  </li> 
		  <li id="LI_A9C7C78FA81F4B66900D033687E9A601"> Two single page documents onto the a double-sided page (2 single-sided pages to 1 double-sided page) 
		  </li> 
		</ul> 
		</p> 
	 </context> 
	 <steps id="STEPS_1DBD645D51B1481EB654FD678A85E604"><!--Reference  appropriate content from Copy a Single Page and Copy Multiple Pages (step 3) topics-->
		<step id="STEP_F42BE30D3555447895A43F748CA82C47" conref="GUID-CF5E8203-1AAC-4BAD-80AA-7EC3CE89B42F#GUID-CF5E8203-1AAC-4BAD-80AA-7EC3CE89B42F/TURN_PRINTER_ON"> 
		  <cmd>Turn the printer on. 
		  </cmd> 
		</step> 
		<step id="STEP_BE8DD0414A6247868F1C2DF4E748180D" conref="GUID-CF5E8203-1AAC-4BAD-80AA-7EC3CE89B42F#GUID-CF5E8203-1AAC-4BAD-80AA-7EC3CE89B42F/PRESS_COPY_BUTTON"> 
		  <cmd>Press the 
			 <uicontrol>Copy</uicontrol> button. 
		  </cmd> 
		</step> 
		<step id="GUID-5F9D35BD-9C2A-455A-AA4F-5A4008C5292D" conref="GUID-EE0C854C-180F-463E-BFE4-21E094AF9201#GUID-EE0C854C-180F-463E-BFE4-21E094AF9201/STEP_A9CAA49ECA6840759E4F018ADB0A7741"> 
		  <cmd>Load the original document in the ADF with the print side down. 
		  </cmd> 
		  <info>The maximum number of pages you can load in the ADF is 30 pages. 
		  </info> 
		  <choices id="CHOICES_F695D41CE50648D197EF0D34AB348D58"> 
			 <choice id="CHOICE_76A11AE51ABB4E8E846E9F8C4D99414D">Here isa fake step 
			 </choice> 
		  </choices> 
		</step> 
		<step id="STEP_8D2F0373C42948E5A94F9A2D4B2B9D57"> 
		  <cmd>Press the 
			 <uicontrol>Two-sided copy</uicontrol> button, then select the copying method with the number buttons. 
		  </cmd> 
		  <choices id="CHOICES_19AA270D2D104DF68DA63D0E434C7E75"> 
			 <choice id="CHOICE_5D4F4DE1C44C4636AB95D14106719755">To copy 1 double-sided page to 1 double-sided page, press the 
				<uicontrol>1</uicontrol> button. 
			 </choice> 
			 <choice id="CHOICE_53C60503F3364A0286E4012A3B89B0E6">To copy 1 double-sided page to 2 single-sided pages, press the 
				<uicontrol>2</uicontrol> button. 
			 </choice> 
			 <choice id="CHOICE_59599CF6514245BA957C6BFCFAABE465">To copy 2 single-sided pages to 1 double-sided page, press the 
				<uicontrol>3</uicontrol> button. 
			 </choice> 
		  </choices> 
		</step> 
		<step id="STEP_7BEB3B4C79514B2EA886EA026CEBE23D" conref="GUID-CF5E8203-1AAC-4BAD-80AA-7EC3CE89B42F#GUID-CF5E8203-1AAC-4BAD-80AA-7EC3CE89B42F/SET_NUMBER_COPIES"> 
		  <cmd>Use the number buttons to specify the number of copies to make. 
		  </cmd> 
		  <info>The default is one copy. 
		  </info> 
		</step> 
		<step id="STEP_AE5EB3EA803C4910AD8B30F07F6DC02D" conref="GUID-CF5E8203-1AAC-4BAD-80AA-7EC3CE89B42F#GUID-CF5E8203-1AAC-4BAD-80AA-7EC3CE89B42F/SET_BW_OR_COLOR"> 
		  <cmd>Specify to make black-and-white or color copies. 
		  </cmd> 
		</step> 
		<step id="STEP_3672BE45BA82412CBC8034BF0257F052" conref="GUID-CF5E8203-1AAC-4BAD-80AA-7EC3CE89B42F#GUID-CF5E8203-1AAC-4BAD-80AA-7EC3CE89B42F/PRESS_GO_BUTTON"> 
		  <cmd>Press the 
			 <uicontrol>GO</uicontrol> button. 
		  </cmd> 
		  <stepresult>The printer delivers the copies through the Document Output Feeder. 
		  </stepresult> 
		</step> 
	 </steps> 
  </taskbody> 
</task>
