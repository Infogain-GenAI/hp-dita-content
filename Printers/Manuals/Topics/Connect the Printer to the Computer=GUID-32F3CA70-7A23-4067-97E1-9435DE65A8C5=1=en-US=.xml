<?ish ishref="GUID-32F3CA70-7A23-4067-97E1-9435DE65A8C5" version="1" lang="en-US"?><task id="GUID-32F3CA70-7A23-4067-97E1-9435DE65A8C5" xml:lang="en-US"> 
  <title id="GUID-EECC6653-7087-4EBA-A41A-6A2D5FA34205">Connect the Printer to the Computer</title> 
  <shortdesc>You connect the printer to the computer using a USB cable. 
  </shortdesc> 
  <prolog> 
	 <metadata> 
		<keywords> 
		  <keyword ishcondition="MODEL=810AIO">810AIO</keyword> 
		  <keyword ishcondition="MODEL=820AIO">820AIO</keyword> 
		  <keyword ishcondition="MODEL=910AIO">910AIO</keyword> 
		  <keyword ishcondition="MODEL=920AIO">920AIO</keyword> 
		  <keyword ishcondition="Series='800_Series'"> 800 Series</keyword> 
		  <keyword ishcondition="Series='900_Series'"> 900 Series</keyword> 
		  <keyword>Acadian</keyword> 
		  <indexterm>USB cable</indexterm> 
		  <indexterm>cables<indexterm>USB</indexterm></indexterm> 
		  <indexterm>CD-ROMs<indexterm>Printer Software</indexterm></indexterm> 
		  <indexterm>software<indexterm>Printer Software CD-ROM</indexterm></indexterm> 
		</keywords> </metadata>
  </prolog> 
  <taskbody> 
	 <steps id="STEPS_AB7C78A42ABF4096BE7865529FFB0496"> 
		<step id="STEP_E6F77412AF2B4E91940E2174199C7A2E"> 
		  <cmd>Turn on your computer and insert the 
			 <cite>Printer Software</cite> CD-ROM. 
		  </cmd> 
		</step> 
		<step id="STEP_9A9C80B516A14479A0D15A144842D394"> 
		  <cmd>Install the printer software following the set up wizard instructions. 
		  </cmd> 
		</step> 
		<step id="STEP_0918B05AE6B34515A5864CD9137636B7"> 
		  <cmd>Plug the USB cable into the printer and the computer. 
		  </cmd> 
		  <info> 
			 <note id="GUID-E29F9744-24FA-4B23-9934-08AB5E926B3D" conref="GUID-9244599E-6CDD-4C73-A045-1D2BFB0399A2#GUID-9244599E-6CDD-4C73-A045-1D2BFB0399A2/NOTE_USB_CONNECTION">To have improved performance, plug the USB cable directly into the computer. Do not plug it into a USB hub. 
			 </note> 
		  </info> 
		</step> 
	 </steps> 
  </taskbody> 
</task>
