<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="printer-config-options">
  <title>HP LaserJet Configuration Parameters</title>
  <shortdesc>
    Reference for all configurable parameters in the HP LaserJet
    administrator settings.
  </shortdesc>
  <refbody>
    <table>
      <title>Network Configuration Parameters</title>
      <tgroup cols="4">
        <colspec colname="param"    colwidth="2*"/>
        <colspec colname="type"     colwidth="1*"/>
        <colspec colname="default"  colwidth="1*"/>
        <colspec colname="desc"     colwidth="3*"/>
        <thead>
          <row>
            <entry>Parameter</entry>
            <entry>Type</entry>
            <entry>Default</entry>
            <entry>Description</entry>
          </row>
        </thead>
        <tbody>
          <row>
            <entry>network.timeout</entry>
            <entry>integer</entry>
            <entry>30</entry>
            <entry>Connection timeout in seconds (range: 5–300)</entry>
          </row>
          <row>
            <entry>network.dhcp.enabled</entry>
            <entry>boolean</entry>
            <entry>true</entry>
            <entry>Enable automatic IP address assignment via DHCP</entry>
          </row>
          <row>
            <entry>network.ipv6.enabled</entry>
            <entry>boolean</entry>
            <entry>false</entry>
            <entry>Enable IPv6 networking support</entry>
          </row>
          <row>
            <entry>print.duplex.default</entry>
            <entry>string</entry>
            <entry>one-sided</entry>
            <entry>Default duplex setting: one-sided, two-sided-long, two-sided-short</entry>
          </row>
          <row>
            <entry>security.pin.required</entry>
            <entry>boolean</entry>
            <entry>false</entry>
            <entry>Require a PIN before releasing print jobs</entry>
          </row>
        </tbody>
      </tgroup>
    </table>
  </refbody>
</reference>
